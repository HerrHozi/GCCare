  "GarminConnectApi": {
    "CustomSelection": {
      "Badge": {
        "Earned": {
          "Where-Object": "",
          "Select-Object": "badgeEarnedDate, badgeName, badgeKey, badgeEarnedNumber, badgePoints, badgeTypeIds"
        },
        "Available": {
          "Where-Object": "{$_.earnedByMe -eq $False}",
          "Select-Object": "badgeEndDate,badgeName, badgeKey, badgeLimitCount, badgePoints, badgeTypeIds"
        },
        "NonCompleted": {
          "Where-Object": "{$_.badgeEarnedDate -eq $null}",
          "Select-Object": "badgeChallengeName, endDate, badgeTargetValue, badgeProgressValue"
        }
      },
      "Activity": {
        "Default": {
          "Where-Object": "",
          "Select-Object": "StartTime, activityName, TypeKey, TotalDistance, TotalTime, ElevGain, Unit"
        },
        "running": {
          "Where-Object": "",
          "Select-Object": "StartTime, activityName, TypeKey, TotalDistance, TotalTime, AvgPace, averageHR, ElevGain, Unit"
        }
      }
    }
  }
